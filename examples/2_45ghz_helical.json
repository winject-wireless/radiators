  "outputs": {
    "s11": [
      {
        "start": 500000000,
        "step": 10000000,
        "end": 4500000000
      }
    ],
    "radiation_frequencies_hz": [
      2450000000
    ],
    "radiation_grid": {
      "theta_step_deg": 5,
      "phi_step_deg": 5
