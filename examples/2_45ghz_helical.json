{
  "schema_version": 2,
  "name": "2.45 GHz Helical",
  "description": "Eight-turn axial-mode helical antenna with a cylindrical capacitive matching post, using the optimized Case 4 geometry for a 50-ohm feed. Single simulation; edit parameters or add a sweep as needed.",
  "units": "mm",
  "parameters": {
    "gap": 5.5,
    "D": 39,
    "H": 226,
    "r": 1,
    "r_matching": 5.5
  },
  "domain": {
    "start": [
      -250,
      -250,
      -200
    ],
    "stop": [
      250,
      250,
      {
        "$expr": "H+160"
      }
    ],
    "boundary": [
      "PML_8",
      "PML_8",
      "PML_8",
      "PML_8",
      "PML_8",
      "PML_8"
    ]
  },
  "mesh": {
    "max_cell_mm": 6,
    "growth_ratio": 1.4,
    "max_cells": 20000000,
    "refinements": [
