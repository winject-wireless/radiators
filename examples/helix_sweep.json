{
  "schema_version": 2,
  "name": "Helix wire diameter and turn count sweep",
  "description": "Example of direct JSON parameter expressions; no separate CAD generator needed.",
  "units": "mm",
  "parameters": {"ground_radius_mm": 45},
  "sweep": {
    "mode": "product",
    "parameters": {
      "wire_mm": {"values": [1, 2]},
      "turns": {"range": {"start": 3, "stop": 4, "step": 1}}
    }
  },
  "domain": {
    "start": [-115, -115, -100], "stop": [115, 115, 120],
    "boundary": ["PML_8", "PML_8", "PML_8", "PML_8", "PML_8", "PML_8"]
  },
  "mesh": {"max_cell_mm": 5, "local_min_cell_mm": 0.5, "growth_ratio": 1.4, "max_cells": 5000000},
  "solver": {"max_timesteps": 20000, "end_criteria": 0.0001, "resources": {"cpus": 2, "memory_gib": 5}},
  "excitation": {"center_hz": 2450000000, "bandwidth_hz": 350000000},
  "materials": [{"name": "pec-metal", "type": "pec"}],
  "geometry": [
    {"name": "ground-disk", "shape": "cylinder", "material": "pec-metal",
     "start": [0, 0, -0.2], "stop": [0, 0, 0], "radius": {"$param": "ground_radius_mm"}},
    {"name": "helix", "shape": "helix", "material": "pec-metal",
     "origin": [0, 0, 3], "axis": [0, 0, 1],
     "diameter": 22, "height": {"$expr": "turns * 6"},
     "turns": {"$param": "turns"}, "wire_diameter": {"$param": "wire_mm"},
     "segments_per_turn": 24}
  ],
  "ports": [{"id": 1, "name": "feed", "type": "lumped", "start": [11, 0, 0],
             "stop": [11, 0, 3], "direction": "z", "impedance_ohm": 50, "excite": true}],
  "outputs": {
    "s11": [{"start": 2300000000, "step": 10000000, "end": 2600000000}],
    "radiation_frequencies_hz": [2450000000],
    "include_realized_gain": true
  }
}
